# Environment variables for download_literature
# Copy to `.env` and fill in real values. `.env` is never committed.

APP_ENV=development
LOG_LEVEL=INFO
LOG_TO_FILE=true
API_TIMEOUT_SECONDS=15

# Data folder OUTSIDE the project (input/ output/ needs_review/ state/ db/ logs/); may be an external drive
DATA_DIR=~/project-data/download-literature

# Local services: always 127.0.0.1 (not localhost / 0.0.0.0)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5

# Library access (OpenAthens). Credentials are only typed on *.openathens.net pages.
OPENATHENS_DOMAIN=ndhu.edu.tw
USER_EMAIL=
USER_PASSWORD=
