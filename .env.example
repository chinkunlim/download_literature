# Environment variables for download_literature
# Copy to `.env` and fill in real values. `.env` is never committed.

APP_ENV=development
LOG_LEVEL=INFO
LOG_TO_FILE=true
API_TIMEOUT_SECONDS=15

# Data folder OUTSIDE the project (input/ output/ needs_review/ state/ db/ logs/); may be an external drive
DATA_DIR=~/project-data/download-literature

# Local services: always 127.0.0.1 (not localhost / 0.0.0.0)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5

# Library access (OpenAthens). Credentials are only typed on *.openathens.net pages.
OPENATHENS_DOMAIN=ndhu.edu.tw
USER_EMAIL=
USER_PASSWORD=
# EBSCO Discovery profile of the library (research.ebsco.com/c/<id>); empty disables the EBSCO route
EBSCO_PROFILE=3pnjf3
# Database URL; empty = SQLite file in DATA_DIR/db/literature.db
DATABASE_URL=
# Local web app port (always 127.0.0.1)
HTTP_PORT=8765
# Extra host names the web app accepts (e.g. host.docker.internal for Open WebUI in Docker); empty = local only
HTTP_ALLOWED_HOSTS=
