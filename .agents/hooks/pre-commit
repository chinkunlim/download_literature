#!/usr/bin/env bash
# =============================================================================
# pre-commit — version-controlled git hook (installed via `git config core.hooksPath .agents/hooks`)
#
# Purpose:
#   Blocks a commit when
#     1. a staged change adds something that looks like a secret (API key, token, private key);
#     2. a credential file (.env, .clasprc.json, *.pem, *.key, app signing keys such as
#        *.jks / *.keystore / *.p8 / *.p12 / *.mobileprovision) is staged anywhere
#        (.clasp.json only holds the Apps Script ID and may be committed);
#     3. a data file (PDF, EPUB, archive, media, database) or a file over 10 MB is staged
#        (data belongs in DATA_DIR outside the project; see .agents/bin/check_staged.py);
#     4. code-review-guard reports CRITICAL issues (layering, secrets, missing docstrings).
#        Exception: files moved unchanged out of legacy/ (git mv, 100% rename) may be committed
#        once without docs so git keeps their history; the next commit must fix them.
#
# Bypass in an emergency (not recommended): git commit --no-verify
# =============================================================================
set -u

SECRET_PATTERN='AIza[0-9A-Za-z_-]{20,}|[0-9]{8,10}:AA[0-9A-Za-z_-]{30,}|gh[opsu]_[0-9A-Za-z]{20,}|github_pat_[0-9A-Za-z_]{20,}|sk-ant-[0-9A-Za-z_-]{20,}|sk-(proj-)?[0-9A-Za-z_-]{20,}|(AKIA|ASIA)[0-9A-Z]{16}|xox[abposr]-[0-9A-Za-z-]{10,}|-----BEGIN ([A-Z]+ )?PRIVATE KEY'

# 1. Secrets on added lines (works before the first commit too)
if git diff --cached -U0 --no-color --diff-filter=ACMR \
    | grep -E '^\+' | grep -vE '^\+\+\+' | grep -Eq "$SECRET_PATTERN"; then
  echo "❌ [PRE-COMMIT BLOCKED] Potential secret/token detected in staged changes."
  echo "   Move it to .env (never committed) and read it in the config layer."
  exit 1
fi

# 2. Credential files at any depth (.env.example is allowed)
if git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '(^|/)(\.env(\..+)?|\.clasprc\.json)$|\.(pem|key|jks|keystore|p8|p12|mobileprovision)$' \
    | grep -vE '(^|/)\.env\.example$' | grep -q .; then
  echo "❌ [PRE-COMMIT BLOCKED] Credential or signing file (.env / .clasprc.json / *.pem / *.key / *.jks / *.p12 ...) is staged."
  exit 1
fi

PY="$(command -v python3 || command -v python || true)"

# 3. Data files and very large files
if [ -n "$PY" ] && [ -f .agents/bin/check_staged.py ]; then
  if ! "$PY" .agents/bin/check_staged.py; then
    echo "❌ [PRE-COMMIT BLOCKED] Data or oversized files are staged (move data to DATA_DIR)."
    exit 1
  fi
fi

# 4. Code review guard (skipped silently when Python or the skill is unavailable)
GUARD=".agents/skills/code-review-guard/scripts/review_guard.py"
if [ -n "$PY" ] && [ -f "$GUARD" ]; then
  if ! "$PY" "$GUARD" --quiet --allow-legacy-moves; then
    echo "❌ [PRE-COMMIT BLOCKED] code-review-guard found CRITICAL issues (run: $PY $GUARD)."
    exit 1
  fi
fi

exit 0
